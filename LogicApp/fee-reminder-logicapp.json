{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "Recurrence": {
                "recurrence": {
                    "interval": 1,
                    "frequency": "Day",
                    "timeZone": "India Standard Time",
                    "schedule": {
                        "hours": [
                            9
                        ],
                        "minutes": [
                            0
                        ]
                    }
                },
                "evaluatedRecurrence": {
                    "interval": 1,
                    "frequency": "Day",
                    "timeZone": "India Standard Time",
                    "schedule": {
                        "hours": [
                            9
                        ],
                        "minutes": [
                            0
                        ]
                    }
                },
                "type": "Recurrence"
            }
        },
        "actions": {
            "Execute_a_SQL_query_(V2)": {
                "runAfter": {},
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['sqldw']['connectionId']"
                        }
                    },
                    "method": "post",
                    "body": {
                        "query": "SELECT\n    StudentID,\n    Name,\n    Email,\n    TotalFee,\n    PaidAmount,\n    DueDate\nFROM dbo.Students\nWHERE PaidAmount < TotalFee\n  AND DueDate < GETDATE();"
                    },
                    "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('default'))},@{encodeURIComponent(encodeURIComponent('default'))}/query/sql",
                    "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "minimumInterval": "PT5S",
                        "maximumInterval": "PT30S"
                    }
                }
            },
            "For_each": {
                "foreach": "@body('Execute_a_SQL_query_(V2)')?['resultsets']?['Table1']",
                "actions": {
                    "Send_an_email_(V2)": {
                        "type": "ApiConnection",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['outlook']['connectionId']"
                                }
                            },
                            "method": "post",
                            "body": {
                                "To": "@items('For_each')?['Email']",
                                "Subject": "Fee Payment Reminder",
                                "Body": "<p class=\"editor-paragraph\">Dear @{items('For_each')?['Name']},<br><br>This is a reminder that your tuition fee payment is overdue.<br><br>Student ID: @{items('For_each')?['StudentID']}<br>Total Fee: ₹@{items('For_each')?['TotalFee']}<br>Paid Amount: ₹@{items('For_each')?['PaidAmount']}<br>Outstanding Amount: ₹@{sub(items('For_each')?['TotalFee'], items('For_each')?['PaidAmount'])}<br>Due Date: @{items('For_each')?['DueDate']}<br><br>Please complete the remaining payment as soon as possible.<br><br>Regards,<br>Finance Office</p>",
                                "Importance": "Normal"
                            },
                            "path": "/v2/Mail",
                            "retryPolicy": {
                                "type": "exponential",
                                "count": 3,
                                "interval": "PT5S",
                                "minimumInterval": "PT5S",
                                "maximumInterval": "PT30S"
                            }
                        }
                    }
                },
                "runAfter": {
                    "Execute_a_SQL_query_(V2)": [
                        "Succeeded"
                    ]
                },
                "type": "Foreach"
            }
        },
        "outputs": {},
        "parameters": {
            "$connections": {
                "type": "Object",
                "defaultValue": {}
            }
        }
    },
    "parameters": {
        "$connections": {
            "type": "Object",
            "value": {
                "sqldw": {
                    "id": "/subscriptions/ced8b134-cb1f-4dd0-90e5-7ba242352373/providers/Microsoft.Web/locations/uaenorth/managedApis/sqldw",
                    "connectionId": "/subscriptions/ced8b134-cb1f-4dd0-90e5-7ba242352373/resourceGroups/FeeManagement-RG-UAE/providers/Microsoft.Web/connections/sqldw",
                    "connectionName": "sqldw",
                    "connectionProperties": {}
                },
                "outlook": {
                    "id": "/subscriptions/ced8b134-cb1f-4dd0-90e5-7ba242352373/providers/Microsoft.Web/locations/uaenorth/managedApis/outlook",
                    "connectionId": "/subscriptions/ced8b134-cb1f-4dd0-90e5-7ba242352373/resourceGroups/FeeManagement-RG-UAE/providers/Microsoft.Web/connections/outlook",
                    "connectionName": "outlook",
                    "connectionProperties": {}
                }
            }
        }
    }
}